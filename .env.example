# KaneAI frontend (kane-fe) — build-time env (Vite). Copy to .env.local for local dev.

# Privy App ID — REQUIRED for wallet login. Create an app at https://dashboard.privy.io
# (set this in the Vercel project env for production, and .env.local for dev).
VITE_PRIVY_APP_ID=

# Agent backend base URL. In production the app reaches the backend same-origin via /api
# (vercel.json rewrite), so this only matters for dev/anvil (e.g. http://localhost:8787).
VITE_AGENT_API=

# Dev-only overrides for a local anvil fork:
VITE_CELO_RPC=
VITE_FACTORY_CELO=
