{
  "name": "kane-remotion",
  "version": "1.0.0",
  "description": "KaneAI landing background — programmatic video (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.500",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.500"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.500",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render src/index.ts KaneBackground ../public/kane-bg.mp4 --crf 26",
    "still": "remotion still src/index.ts KaneBackground out/frame.png --frame=75",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}